# SourceHero AI configuration.
# For local development, use docker-compose.yml to start PostgreSQL and MinIO.
# For production, set these via your hosting platform's environment variables.

# ============================================================
# Database (PostgreSQL)
# ============================================================
# Local development (docker-compose): postgresql://sourcehero:sourcehero_dev@localhost:5432/sourcehero
# Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ============================================================
# Supabase (Auth + Database)
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============================================================
# Cloudflare R2 (File Storage)
# ============================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sourcehero-files
R2_PUBLIC_URL=

# For local development with MinIO (S3-compatible):
# R2_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# R2_BUCKET_NAME=sourcehero-files
# R2_REGION=us-east-1

# ============================================================
# OpenAI (Optional - for embeddings and synthesis)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Application Settings
# ============================================================
SOURCEHERO_API_PORT=8000
SOURCEHERO_HTTP_TIMEOUT=20
SOURCEHERO_ENV=development
# How often the in-process scheduler polls for due jobs. Lower = more responsive, higher = less DB chatter.
SOURCEHERO_SCHEDULER_POLL_SECONDS=60
# Local fallback vector index directory. Leave empty to use the system temp dir.
# In cloud prod this is unused (pgvector handles storage); kept here for parity with local dev.
SOURCEHERO_VECTOR_DIR=

# ============================================================
# CORS (comma-separated origins)
# ============================================================
CORS_ORIGINS=http://localhost:3000
