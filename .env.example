# SourceHero v2 configuration. Copy to .env and adjust. Never commit .env.
# Every field here maps 1:1 to a Settings field in app/core/config.py.

# --- core ---
# development|test|production
SOURCEHERO_ENV=development
# JWT HS256 + Fernet key derivation. The app refuses to start in production with
# the shipped value, so replace it before any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SOURCEHERO_SECRET_KEY=dev-insecure-change-me
# host port of the compose Postgres
DB_PORT=54339
API_PORT=8787
WEB_PORT=3787
DATABASE_URL=postgresql+psycopg://sourcehero:sourcehero_dev@127.0.0.1:54339/sourcehero
TEST_DATABASE_URL=postgresql+psycopg://sourcehero:sourcehero_dev@127.0.0.1:54339/sourcehero_test
EVAL_DATABASE_URL=postgresql+psycopg://sourcehero:sourcehero_dev@127.0.0.1:54339/sourcehero_eval
E2E_DATABASE_URL=postgresql+psycopg://sourcehero:sourcehero_dev@127.0.0.1:54339/sourcehero_e2e
E2E_API_PORT=8797
E2E_WEB_PORT=3797
# comma-separated string; split in code
CORS_ORIGINS=http://127.0.0.1:3787,http://localhost:3787
# used for OAuth callback redirects
PUBLIC_WEB_URL=http://localhost:3787
DATA_DIR=./data
# --- auth ---
# local|supabase
AUTH_MODE=local
ALLOW_REGISTRATION=true
JWT_TTL_HOURS=168
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# --- storage ---
# local|s3
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=sourcehero-files
S3_REGION=auto
# --- ingestion ---
FETCH_ALLOW_PRIVATE=false
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_BYTES=10485760
RESPECT_ROBOTS=true
PER_HOST_MIN_INTERVAL_SECONDS=1.0
USER_AGENT=SourceHero/2.0 (+https://github.com/JeremyL691/SourceHero-AI)
# --- jobs ---
# true = run handlers synchronously (tests)
JOBS_INLINE=false
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1.0
JOB_STALE_SECONDS=300
# multiplies every debounce delay; e2e uses 0.02
JOB_DEBOUNCE_SCALE=1.0
SCHEDULER_TICK_SECONDS=30
# 0=Monday
WEEKLY_DIFF_DAY=0
WEEKLY_DIFF_TIME=08:00
# --- embeddings / retrieval ---
# hashing|fastembed|openai_compat  (default hashing: deterministic, no download)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=./.cache/fastembed
# none|fastembed
RERANK_PROVIDER=none
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=50
RRF_K=60
# --- claims thresholds (per-embedder defaults applied in code when blank) ---
CLUSTER_SIM=
PAIR_SIM=
DUP_SIM=
CARRY_SIM=
TOPIC_SIM=
MAX_JUDGE_PAIRS_PER_CLAIM=5
# --- LLM ---
# fake|openai_chat|openai_responses|anthropic_messages
LLM_PROVIDER=fake
# opencode-go|openai|custom (fills defaults below)
LLM_PRESET=
LLM_BASE_URL=
# api_key|command|oauth
LLM_AUTH=api_key
LLM_API_KEY=
# shell command that prints a bearer token on stdout
LLM_TOKEN_COMMAND=
LLM_TOKEN_TTL_SECONDS=300
# JSON object
LLM_EXTRA_HEADERS=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# auto|json_object|prompt
LLM_JSON_MODE=auto
# authorization (Bearer) | x-api-key
LLM_AUTH_HEADER=authorization
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=120
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_CASSETTE_MODE=off
LLM_CASSETTE_PATH=
# --- OAuth (generic OAuth2 Authorization Code + PKCE; values supplied by human) ---
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=
OAUTH_REDIRECT_URI=http://localhost:8787/v1/settings/llm/oauth/callback
# JSON object
OAUTH_EXTRA_AUTHORIZE_PARAMS=
